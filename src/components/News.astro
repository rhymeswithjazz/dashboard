---
import type { NewsData } from "../lib/sample-data";
interface Props { data: NewsData }
const { data } = Astro.props;
---
<section class="section">
  <h2>News</h2>
  <hr class="rule">
  <ul class="feed">
    {data.items.map((it) => (
      <li>
        <span class="tag">{it.tag}</span>
        <div class="title">{it.title}</div>
        <div class="sub">{it.sub}</div>
      </li>
    ))}
  </ul>
</section>

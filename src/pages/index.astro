---
import Newsprint from "../layouts/Newsprint.astro";
import Masthead from "../components/Masthead.astro";
import Briefing from "../components/Briefing.astro";
import Today from "../components/Today.astro";
import Sports from "../components/Sports.astro";
import News from "../components/News.astro";
import Picture from "../components/Picture.astro";
import Curiosity from "../components/Curiosity.astro";
import { getModeMeta, formatDateET, formatTimeET, volumeNumber } from "../lib/mode";
import { sampleData } from "../lib/sample-data";
import { loadConfig } from "../lib/config";
import { fetchWeather } from "../data/weather";
import { fetchWikipediaPack, pickWord } from "../data/wikipedia";
import { fetchWordOfTheDay } from "../data/mw";
import { fetchNews } from "../data/news";
import { fetchSports } from "../data/sports";
import { fetchCalendar } from "../data/calendar";
import { fetchBriefing } from "../data/briefing";

const { mode, label, builtAt } = getModeMeta();
const config = loadConfig();
const fallback = sampleData(mode);

const [weather, wiki, mwWord, news, sports, calEvents] = await Promise.all([
  fetchWeather(config.location, mode),
  fetchWikipediaPack(),
  fetchWordOfTheDay(process.env["MW_API_KEY"]),
  fetchNews(config.news),
  fetchSports(config.sports, config.location.timezone),
  fetchCalendar(process.env["CAL_ICS_URLS"], mode, config.location.timezone),
]);

const word = mwWord ?? pickWord(builtAt);

const calendar = {
  heading: mode === "warmup" ? "Today" : "Tomorrow",
  events: calEvents ?? fallback.calendar.events,
};

const data = {
  ...fallback,
  weather: weather ?? fallback.weather,
  picture: wiki.picture,
  news: news ?? fallback.news,
  sports: sports ?? fallback.sports,
  calendar,
  curio: {
    onThisDay: wiki.onThisDay ?? fallback.curio.onThisDay,
    word,
    wiki: wiki.randomWiki ?? fallback.curio.wiki,
  },
};

// Briefing depends on everything else, so it runs after the parallel batch.
const briefing = await fetchBriefing(
  data,
  mode,
  config.location.city,
  process.env["ANTHROPIC_API_KEY"],
);
data.briefing = briefing ?? fallback.briefing;

const dateLabel = formatDateET(builtAt);
const volume = volumeNumber(builtAt);
const builtLabel = `Printed at ${formatTimeET(builtAt)} ET · dashboard.example.com`;

const briefingHeading = mode === "warmup" ? "Morning Briefing" : "Evening Briefing";

const todayKicker =
  mode === "warmup"
    ? `${config.location.city} · the day ahead`
    : `${config.location.city} · what's on deck tomorrow`;
---
<Newsprint title={`The Daily · ${label}`}>
  <Masthead modeLabel={label} dateLabel={dateLabel} volume={volume} />
  <Briefing heading={briefingHeading} data={data.briefing} />
  <Today weather={data.weather} calendar={data.calendar} kicker={todayKicker} />
  <Sports data={data.sports} />
  <News data={data.news} />
  {data.picture && <Picture data={data.picture} />}
  <Curiosity data={data.curio} />
  <footer class="colophon">{builtLabel}</footer>
</Newsprint>
